/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vue-inertia-crud",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"alias": {
		"node:module": "./src/shims/node-module.ts"
	},
	"observability": {
		"enabled": true
	},
    /** Minify the Worker script before uploading. */
	"minify": true,
	"upload_source_maps": true,
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
     *
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
     *
	 * Use this command
	 * 'bun wrangler secret put GOOGLE_CLIENT_SECRET'
	 * to add a google secret
	 */
    "vars": {
       "NODE_ENV": "production",
       "GITHUB_CLIENT_ID": "<fill in your Github APP token client-id>",
       "GOOGLE_CLIENT_ID": "<fill in your Google Cloud oauth client-id>",
       // Optional allow-list of agent capabilities (comma-separated).
       // Unset = all agent features enabled; when set, anything not listed
       // answers 403. 'products' covers the agent product write API
       // (POST/PATCH/DELETE /agent/products*). Local dev overrides this via .env.
       // "AGENT_ENABLED": "products",
       // Master switch = whole agent feature off: /agent/* answers 404 and the
       // UI hides its agent-pairing section. Local dev overrides this via .env.
       // "AGENT_DISABLED": "1"
    },
	"keep_vars": true,
	/**
     * keep_vars: also keeps secrets.
     */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inertia-crud"
		}
	],
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
