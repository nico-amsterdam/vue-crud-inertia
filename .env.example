ACCOUNT_ID="YOUR CLOUDFLARE ACCOUNT ID"
DB_ID="YOUR DATABASE ID"
CF_TOKEN="CLOUDFLARE TOKEN FOR WRANGLER LOGIN"
# OAuth apps: see auth-setup-github.md / auth-setup-google.md in bun-htmx-crud.
# Callback / redirect uri: <origin>/auth/github and <origin>/auth/google
GITHUB_CLIENT_ID="YOUR GITHUB OAUTH APP CLIENT ID"
GITHUB_CLIENT_SECRET="YOUR GITHUB OAUTH APP CLIENT SECRET"
GOOGLE_CLIENT_ID="YOUR GOOGLE OAUTH CLIENT ID"
GOOGLE_CLIENT_SECRET="YOUR GOOGLE OAUTH CLIENT SECRET"
# Secret used to sign the SESSION cookie and the OAuth state HMAC.
SESSION_SECRET="A LONG RANDOM STRING"
# Signs the one-shot Inertia flash cookie (success messages).
INERTIA_FLASH_SECRET="ANOTHER LONG RANDOM STRING"
# Set to 1 to skip login for local testing (runs as dev:local; ignored in production).
# AUTH_DISABLED=1
