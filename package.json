{
  "name": "hono-inertia-lenny",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,green \"bun run dev:server\" \"bun run dev:vite\"",
    "dev:server": "bun --watch run src/index.ts",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun run src/index.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@inertiajs/vue3": "^3.9.1",
    "@sneakylenny/inertia-hono": "^0.3.5",
    "hono": "^4.13.13",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
